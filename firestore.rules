rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Deny all access by default
    match /{document=**} {
      allow read, write: if false;
    }

    // User-scoped data: only the authenticated owner can access
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // Projects collection
      match /projects/{projectId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;

        // All subcollections under a project
        match /{subcollection}/{docId} {
          allow read, write: if request.auth != null && request.auth.uid == userId;
        }
      }

      // Global prompts and documents
      match /global_prompts/{promptId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      match /global_documents/{docId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // User settings (toolchain defaults, etc.)
      match /settings/{settingId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}
